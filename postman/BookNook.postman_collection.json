          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Guest updated successfully', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(1);",
                  "    pm.expect(jsonData.name).to.include('Updated');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5. Delete guest",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/guests/999",
              "host": ["{{baseUrl}}"],
              "path": ["guests", "999"]
            },
            "description": "Attempt to delete a guest. Demonstrates 404 for non-existent, 409 if bookings exist, or 200 if deleted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 (Not Found) or 200 (Deleted)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
