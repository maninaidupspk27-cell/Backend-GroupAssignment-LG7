                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma (Updated)\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"phone\": \"+91-9876543200\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/guests/1",
              "host": ["{{baseUrl}}"],
              "path": ["guests", "1"]
