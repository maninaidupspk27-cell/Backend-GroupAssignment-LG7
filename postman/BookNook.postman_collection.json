    {
      "name": "Special Twist - Free On This Date",
      "item": [
        {
          "name": "15. Get available games by date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games/available?date=2026-11-20",
              "host": ["{{baseUrl}}"],
              "path": ["games", "available"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-11-20"
                }
              ]
            },
            "description": "Query games available on a given date (no active booking covering that date)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns an array of available games', function () {",
                  "    var games = pm.response.json();",
                  "    pm.expect(games).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "16. Invalid booking date test (MANDATORY TEST 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guest_id\": 1,\n  \"game_id\": 14,\n  \"start_date\": \"2026-11-12\",\n  \"end_date\": \"2026-11-10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            },
            "description": "MANDATORY TEST 1: End date before start date must return HTTP 400 with 'End date cannot be before start date.'"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('MANDATORY TEST 1: Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('MANDATORY TEST 1: Response contains exact error message', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.include('End date cannot be before start date.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "17. Check Game 14 availability on November 11 (MANDATORY TEST 2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games/available?date=2026-11-11",
              "host": ["{{baseUrl}}"],
              "path": ["games", "available"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-11-11"
                }
              ]
            },
            "description": "MANDATORY TEST 2: Game 14 is booked from 2026-11-10 to 2026-11-12, so on 2026-11-11 it MUST NOT appear."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('MANDATORY TEST 2: Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('MANDATORY TEST 2: Game 14 is NOT in the available games list', function () {",
                  "    var games = pm.response.json();",
                  "    pm.expect(games).to.be.an('array');",
                  "    var game14 = games.find(function(g) { return g.id === 14; });",
                  "    pm.expect(game14).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "18. Check Game 14 availability on November 13 (MANDATORY TEST 3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games/available?date=2026-11-13",
              "host": ["{{baseUrl}}"],
              "path": ["games", "available"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-11-13"
                }
              ]
            },
            "description": "MANDATORY TEST 3: Game 14 booking ended on 2026-11-12, so on 2026-11-13 it MUST appear in the available list."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('MANDATORY TEST 3: Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('MANDATORY TEST 3: Game 14 IS present in available games list', function () {",
                  "    var games = pm.response.json();",
                  "    pm.expect(games).to.be.an('array');",
                  "    var game14 = games.find(function(g) { return g.id === 14; });",
                  "    pm.expect(game14).to.not.be.undefined;",
                  "    pm.expect(game14.name).to.eql('Game 14');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
