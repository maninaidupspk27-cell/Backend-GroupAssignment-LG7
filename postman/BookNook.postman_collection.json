        {
          "name": "11. Search games by players",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games?players=4",
              "host": ["{{baseUrl}}"],
              "path": ["games"],
              "query": [
                {
                  "key": "players",
                  "value": "4"
                }
              ]
            },
            "description": "Search games capable of accommodating 4 players (min_players <= 4 AND max_players >= 4)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All returned games accommodate 4 players', function () {",
                  "    var games = pm.response.json();",
                  "    pm.expect(games).to.be.an('array');",
                  "    games.forEach(function(g) {",
                  "        pm.expect(g.min_players).to.be.at.most(4);",
                  "        pm.expect(g.max_players).to.be.at.least(4);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
