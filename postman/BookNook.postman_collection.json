    "description": "Comprehensive Postman test collection for BookNook Cafe – Board Game Booking Management System (Backend Fundamentals Group Assignment YG-CSEDS2B-G07). Includes all CRUD endpoints, SQL JOIN booking details, capacity search, and the Free on this date Special Twist scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Guest APIs",
      "item": [
        {
          "name": "1. Get all guests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/guests",
              "host": ["{{baseUrl}}"],
              "path": ["guests"]
            },
            "description": "Retrieve all registered guests (at least 30 records)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns at least 30 guest records', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.at.least(30);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Get guest by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/guests/1",
              "host": ["{{baseUrl}}"],
              "path": ["guests", "1"]
            },
            "description": "Retrieve a specific guest by their primary key ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Guest has id, name, and email', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(1);",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "    pm.expect(jsonData).to.have.property('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Add guest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sameer Joshi\",\n  \"email\": \"sameer.joshi@example.com\",\n  \"phone\": \"+91-9876543299\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/guests",
              "host": ["{{baseUrl}}"],
              "path": ["guests"]
            },
            "description": "Add a new guest with valid name, unique email, and phone."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 409 if already exists', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.name).to.eql('Sameer Joshi');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
